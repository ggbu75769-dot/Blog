{
  "schema_version": "4.1.0",
  "status": "proposed_initial_defaults_not_naver_rules",
  "mode": "REPLAY",
  "timezone": "Asia/Seoul",
  "public_posting_enabled": false,
  "primary_goal": {
    "platform": "naver",
    "scope": "single_primary_blog",
    "metric": "calendar_month_pv",
    "target": 1000000
  },
  "capacity": {
    "initial_active_profiles": 2,
    "candidates_per_run": 50,
    "deep_compare_per_run": 10,
    "research_per_run": 3,
    "articles_per_blog_per_day": 2,
    "ready_queue_per_blog": 2,
    "ready_queue_total": 6,
    "worker_concurrency": 2
  },
  "budget": {
    "monthly_budget_minor": null,
    "currency": "KRW",
    "require_approved_budget_for_paid_call": true,
    "include_pending_reservations": true
  },
  "retries": {
    "http_attempts": 3,
    "schema_repair": 1,
    "voice_edit": 2,
    "research_repair": 2,
